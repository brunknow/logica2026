//Vetor é uma variavel que guarda varios valores / criar um vetor para 5 nomes de pessoas e depois imprimir os 5 nomes
programa {
  funcao inicio() {
    cadeia nome[5]
    
    para(inteiro i=0; i<5; i++){
      escreva("Digite seu nome: ")
      leia(nome[i])
      escreva(nome[i], "\n")
    }
      }
}
